{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Explode map",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "program": "patchwork-mapconverter",
            "args": [
                "-p",
                "--ct",
                "--td",
                "./triggerdata.txt",
                "--si",
                "--chunkify",
                "--chunk-size",
                "5,5,0,0",
                "war2json",
                "./build.w3x",
                "./map",
                "--gtp"
            ]
        },
        {
            "name": "Build Map",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npx",
            "program": "patchwork-mapconverter",
            "args": [
                "--ct",
                "--td",
                "./triggerdata.txt",
                "--si",
                "--chunkify",
                "json2war",
                "./map",
                "./build.w3x",
                "latest"
            ]
        },
        {
            "name": "Install Patchwork",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "program": "install",
            "args": [
                "-g",
                "patchwork-mapconverter",
                "--allow-scripts=koffi"
            ]
        }
    ]
}